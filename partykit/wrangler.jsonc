{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "playhtml",
  "main": "party.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.playhtml.fun",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_KEY",
      "ADMIN_TOKEN",
      "PARTYKIT_BRIDGE_SECRET"
    ]
  },
  // Per-IP limit on requests to rooms, checked before a Durable Object wakes.
  // Set high enough that a venue or carrier NAT with thousands of people behind
  // one IP all opening a page at once stays under it; it only stops one source
  // opening rooms at machine speed.
  // namespace_id is an arbitrary account-unique id; staging uses its own.
  "ratelimits": [
    {
      "name": "CONNECTION_RATE_LIMITER",
      "namespace_id": "4501",
      "simple": { "limit": 6000, "period": 60 }
    }
  ],
  // Operator control plane for room quarantine. Read before hydration, so a room
  // that crashes on start can still be taken out of service.
  "kv_namespaces": [
    {
      "binding": "QUARANTINE_CONTROL",
      "id": "ca43215f51df4d699551fea9ed684e87",
      "preview_id": "b40ca25277454bf59cfbc0a17bc0098f"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "PartyServer"
      },
      {
        "name": "Presence",
        "class_name": "PresenceServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PartyServer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PresenceServer"]
    }
  ],
  "env": {
    "staging": {
      "name": "playhtml-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api-staging.playhtml.fun",
          "custom_domain": true
        }
      ],
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": false
        }
      },
      "secrets": {
        "required": [
          "SUPABASE_URL",
          "SUPABASE_KEY",
          "ADMIN_TOKEN",
          "PARTYKIT_BRIDGE_SECRET"
        ]
      },
      "ratelimits": [
        {
          "name": "CONNECTION_RATE_LIMITER",
          "namespace_id": "4502",
          "simple": { "limit": 6000, "period": 60 }
        }
      ],
      "kv_namespaces": [
        {
          "binding": "QUARANTINE_CONTROL",
          "id": "b0d93abaea7d40adae9fced738e54155",
          "preview_id": "b40ca25277454bf59cfbc0a17bc0098f"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Main",
            "class_name": "PartyServer"
          },
          {
            "name": "Presence",
            "class_name": "PresenceServer"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["PartyServer"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["PresenceServer"]
        }
      ]
    }
  }
}
