# Local development environment variables
# Copy this file to .dev.vars and fill in your values
# .dev.vars is gitignored and used by `wrangler dev`

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-here
ADMIN_KEY=your-admin-key-here
RESEND_API_KEY=your-resend-api-key-here
CODA_API_TOKEN=your-coda-api-token-here

# Optional: TypeSafe Jev key. When set, the site categorizer asks Jev instead of Clef.
JEV_TOKEN=your-jev-key

# Optional: tag new mailing-list contacts with this Resend segment.
RESEND_SEGMENT_ID=your-resend-segment-id

# Optional: shared password that opens /internet-map bundles (ADMIN_KEY always works).
INTERNET_MAP_PASSWORD=your-internet-map-password

# Optional: origin that collage share links open on, e.g. a local website dev server.
# Unset means https://wewere.online.
COLLAGE_VIEWER_ORIGIN=http://localhost:5173

# "true" rejects unsigned participant color updates and access requests with 401;
# anything else accepts them as legacy requests. wrangler.toml [vars] sets "false".
REQUIRE_PARTICIPANT_SIGNATURES=false
