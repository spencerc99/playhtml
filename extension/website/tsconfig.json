{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@movement/*": ["./shared/*"],
      "@extension/*": ["../src/*"]
    }
  },
  // The experiment directories are added as each one is brought up to strict.
  // "sounds" is clean; the others still carry unused-import and JSX-typing
  // errors that predate this config covering them.
  "include": ["src", "shared", "sounds"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
