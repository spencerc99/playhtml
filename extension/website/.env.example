# Override the Cloudflare Worker base URL for experiments.
# Leave unset to default to the production worker.
VITE_WORKER_URL=https://playhtml-game-api.spencerc99.workers.dev

# Where shared collages' pictures are read from. Defaults to VITE_WORKER_URL
# when that is set, else https://assets.wewere.online.
# VITE_ASSETS_URL=https://assets.wewere.online

# Override only the curation catalog API. Local curation defaults to port 8787.
VITE_CATALOG_WORKER_URL=http://127.0.0.1:8787
