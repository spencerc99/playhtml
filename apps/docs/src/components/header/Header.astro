---
// ABOUTME: Docs header, matching the playhtml.fun homepage header: wordmark, site nav,
// ABOUTME: then search, presence, Discord, GitHub stars, support and the theme toggle.
import Search from "virtual:starlight/components/Search";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import { DocsPresenceBar } from "../react/DocsPresenceBar";
import SiteNavLinks from "./SiteNavLinks.astro";
import { discordHref, githubHref, supportHref } from "./site-nav";
---

<div class="ph-header">
  <a class="ph-header__wordmark" href="/" aria-label="playhtml home" translate="no"
    >playhtml</a
  >
  <nav class="ph-header__nav" aria-label="Site">
    <SiteNavLinks />
  </nav>
  <details class="ph-header__menu">
    <summary aria-label="Site menu">
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path
          d="M3 5h14M3 10h14M3 15h14"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </summary>
    <nav class="ph-header__menu-panel" aria-label="Site menu">
      <SiteNavLinks />
    </nav>
  </details>
  <div class="ph-header__search print:hidden">
    <Search />
  </div>
  <div class="ph-header__right print:hidden">
    <div class="ph-presence-slot">
      {/* client:only: presence reads cursor awareness, which only exists in the browser. */}
      <DocsPresenceBar client:only="react" />
    </div>
    <a class="ph-header__icon" href={discordHref} aria-label="Discord">
      <svg viewBox="0 0 127.14 96.36" aria-hidden="true" focusable="false">
        <path
          d="M107.7 8.1A105.2 105.2 0 0 0 81.5 0a72.1 72.1 0 0 0-3.4 7A97.7 97.7 0 0 0 49 7a72.1 72.1 0 0 0-3.4-7 105.9 105.9 0 0 0-26.2 8.1C2.8 32.8-1.7 56.9 0.5 80.6a105.7 105.7 0 0 0 32.2 16.3 77.2 77.2 0 0 0 6.9-11.2 68.3 68.3 0 0 1-10.8-5.2c0.9-0.7 1.8-1.4 2.7-2a75.4 75.4 0 0 0 64.1 0c0.9 0.7 1.8 1.4 2.7 2a68.6 68.6 0 0 1-10.8 5.2 77 77 0 0 0 6.9 11.2 105.3 105.3 0 0 0 32.2-16.3c2.7-27.4-4.7-51.3-18.9-72.5ZM42.5 66c-6.3 0-11.5-5.8-11.5-13s5.1-13 11.5-13c6.4 0 11.6 5.9 11.5 13 0 7.2-5.1 13-11.5 13Zm42.1 0c-6.3 0-11.5-5.8-11.5-13s5.1-13 11.5-13c6.4 0 11.6 5.9 11.5 13 0 7.2-5.1 13-11.5 13Z"
        ></path>
      </svg>
    </a>
    <a class="ph-header__icon" href={githubHref} aria-label="playhtml on GitHub">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path
          d="M8 0.2a8 8 0 0 0-2.5 15.6c0.4 0.1 0.5-0.2 0.5-0.4v-1.5c-2.2 0.5-2.7-0.9-2.7-0.9-0.4-0.9-0.9-1.2-0.9-1.2-0.7-0.5 0.1-0.5 0.1-0.5 0.8 0.1 1.2 0.8 1.2 0.8 0.7 1.2 1.9 0.9 2.3 0.7 0.1-0.5 0.3-0.9 0.5-1.1-1.8-0.2-3.6-0.9-3.6-3.9 0-0.9 0.3-1.6 0.8-2.1-0.1-0.2-0.4-1 0.1-2.1 0 0 0.7-0.2 2.2 0.8a7.5 7.5 0 0 1 4 0c1.5-1 2.2-0.8 2.2-0.8 0.5 1.1 0.2 1.9 0.1 2.1 0.5 0.6 0.8 1.3 0.8 2.1 0 3-1.8 3.7-3.6 3.9 0.3 0.3 0.6 0.8 0.6 1.6v2.1c0 0.2 0.1 0.5 0.5 0.4A8 8 0 0 0 8 0.2Z"
        ></path>
      </svg>
      <span class="ph-header__stars" data-github-stars hidden></span>
    </a>
    <a class="ph-header__support" href={supportHref}>support</a>
    <ThemeSelect />
  </div>
</div>

<script>
  // GitHub star count next to the icon. Cached for the session so moving
  // between docs pages doesn't spend the unauthenticated API rate limit.
  const StarsKey = "ph-github-stars";

  function showStars(stars: number) {
    const label = document.querySelector<HTMLElement>("[data-github-stars]");
    if (!label) return;
    label.textContent = new Intl.NumberFormat("en", {
      notation: "compact",
      maximumFractionDigits: 1,
    })
      .format(stars)
      .toLowerCase();
    label.closest("a")?.setAttribute("aria-label", `GitHub, ${stars} stars`);
    label.hidden = false;
  }

  let cached: number | undefined;
  try {
    const value = Number(sessionStorage.getItem(StarsKey));
    if (value > 0) cached = value;
  } catch {}

  if (cached) {
    showStars(cached);
  } else {
    fetch("https://api.github.com/repos/spencerc99/playhtml", {
      headers: { Accept: "application/json" },
    })
      .then((response) => (response.ok ? response.json() : undefined))
      .then((repo) => {
        const stars = repo?.stargazers_count;
        if (typeof stars !== "number" || !Number.isFinite(stars)) return;
        showStars(stars);
        try {
          sessionStorage.setItem(StarsKey, String(stars));
        } catch {}
      })
      .catch(() => {});
  }
</script>
