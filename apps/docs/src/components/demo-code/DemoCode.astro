---
// ABOUTME: Shows the Vanilla HTML and React source for a live docs demo.
// ABOUTME: Collapsed under the demo so the page stays scannable; tabs sync site-wide.

import { TabItem, Tabs } from "@astrojs/starlight/components";
import { Code } from "astro:components";
import type { ExampleRecipe } from "../playground/recipes/types";
import type { DemoSnippet } from "./types";

type Props = {
  /** Start expanded. Use when the demo is the main point of the section. */
  open?: boolean;
  /** Summary text, for when the demo isn't directly above. */
  label?: string;
} & (
  | { snippet: DemoSnippet }
  // A playground recipe: shows its full page source and links to its example.
  | { recipe: ExampleRecipe }
);

const { open = false, label = "Code for this demo" } = Astro.props;
const recipe = "recipe" in Astro.props ? Astro.props.recipe : undefined;
const snippet: DemoSnippet =
  "snippet" in Astro.props
    ? Astro.props.snippet
    : { html: recipe!.html, react: recipe!.react?.code ?? "" };

// Match the site's fenced code blocks (astro.config.mjs shikiConfig).
const themes = { light: "github-light", dark: "github-dark" } as const;
---

<details class="ph-demo-code" open={open}>
  <summary>{label}</summary>
  {recipe && (
    <p>
      Full page source. Open <a href={recipe.docsHref}>{recipe.title}</a> to
      remix it in the playground.
    </p>
  )}
  <Tabs syncKey="framework">
    <TabItem label="Vanilla HTML">
      <Code code={snippet.html} lang="html" themes={themes} defaultColor="light" />
    </TabItem>
    <TabItem label="React">
      {snippet.reactNote && <p>{snippet.reactNote}</p>}
      <Code code={snippet.react} lang="tsx" themes={themes} defaultColor="light" />
      {snippet.reactCss && <Code code={snippet.reactCss} lang="css" themes={themes} defaultColor="light" />}
    </TabItem>
  </Tabs>
</details>

<style>
  .ph-demo-code {
    margin-block: 0.75rem 1.5rem;
  }

  .ph-demo-code > summary {
    width: fit-content;
    cursor: pointer;
    font-family: var(--ph-font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ph-ink-2);
  }

  .ph-demo-code > summary:hover {
    color: var(--ph-ink);
  }

  .ph-demo-code[open] > summary {
    margin-bottom: 0.5rem;
  }

  .ph-demo-code :global(pre) {
    max-height: min(70vh, 42rem);
    overflow: auto;
  }
</style>
